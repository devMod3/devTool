{
  "manifest_version": 3,
  "name": "Zen DevTool",
  "version": "0.3.0",
  "description": "Inspector y Product Flow Mapper local con arquitectura limpia para Brave/Chromium.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Abrir Zen DevTool"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Abrir o cerrar Zen DevTool"
    }
  }
}
